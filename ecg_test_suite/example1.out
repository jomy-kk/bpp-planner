;; Expected solution for example1.pddl
;; Basic ECG Signal Processing and QRS Detection Pipeline

;; Step 1: Fill slot1 with bandpass filter for initial denoising
(fill-slot slot1 bandpass_filter)

;; Step 2: Fill slot2 with notch filter for power line interference removal
(fill-slot slot2 notch_filter)

;; Step 3: Fill slot3 with wavelet denoising for further noise reduction
(fill-slot slot3 wavelet_denoising)

;; Step 4: Fill slot4 with Pan-Tompkins QRS detector for heartbeat detection
(fill-slot slot4 qrs_detector_pan_tompkins)

;; Step 5: Fill slot5 with heart rate calculator for feature extraction
(fill-slot slot5 heart_rate_calculator)

;; Step 6: Complete the pipeline
(complete-pipeline)

;; FINAL PIPELINE:
;; timeseries -> [bandpass_filter] -> timeseries -> [notch_filter] -> timeseries -> [wavelet_denoising] -> timeseries -> [qrs_detector_pan_tompkins] -> event -> [heart_rate_calculator] -> scalar

;; SOLUTION EXPLANATION:
;; This solution correctly implements the basic ECG processing pipeline:
;; 1. bandpass_filter: Removes baseline wander and high-frequency noise (0.5-40 Hz range)
;; 2. notch_filter: Eliminates power line interference (50/60 Hz)
;; 3. wavelet_denoising: Further reduces noise while preserving QRS morphology
;; 4. qrs_detector_pan_tompkins: Detects QRS complexes and R-peaks using the standard Pan-Tompkins algorithm
;; 5. heart_rate_calculator: Computes instantaneous heart rate from detected R-peaks

;; The planner should select these specific blocks from the large library (143 total blocks)
;; based on their purposes and input/output type compatibility. 